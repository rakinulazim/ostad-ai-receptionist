    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst call = body.call || {};\nconst analysis = call.call_analysis || {};\nconst durationSec = call.duration_ms ? Math.round(call.duration_ms / 1000) : (call.end_timestamp && call.start_timestamp ? Math.round((call.end_timestamp - call.start_timestamp) / 1000) : 0);\nconst mins = Math.floor(durationSec / 60);\nconst secs = durationSec % 60;\nreturn [{ json: {\n  call_id: call.call_id || '',\n  caller_number: call.from_number || call.to_number || '',\n  timestamp: call.start_timestamp ? new Date(call.start_timestamp).toISOString() : new Date().toISOString(),\n  duration_seconds: durationSec,\n  duration_formatted: `${mins}m ${secs}s`,\n  intent: (analysis.custom_analysis_data && analysis.custom_analysis_data.intent) || 'unknown',\n  sentiment: analysis.user_sentiment || 'Unknown',\n  summary: analysis.call_summary || '',\n  transcript: (call.transcript || '').slice(0, 45000)\n} }];"
      },
