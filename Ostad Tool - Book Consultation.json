    {
      "parameters": {
        "jsCode": "const req = $('Tool Input').first().json;\n\n// Convert different time formats to HH:MM (24-hour)\nfunction to24Hour(time) {\n  if (!time) return \"\";\n\n  let t = String(time).trim().toLowerCase();\n\n  // Already 24-hour format (14:30)\n  if (/^\\d{1,2}:\\d{2}$/.test(t)) {\n    return t.padStart(5, \"0\");\n  }\n\n  // 12-hour format (2:30 PM)\n  const match = t.match(/^(\\d{1,2})(?::(\\d{2}))?\\s*(am|pm)$/);\n\n  if (!match) return t;\n\n  let hour = parseInt(match[1], 10);\n  const minute = match[2] || \"00\";\n  const period = match[3];\n\n  if (period === \"pm\" && hour !== 12) hour += 12;\n  if (period === \"am\" && hour === 12) hour = 0;\n\n  return `${String(hour).padStart(2,\"0\")}:${minute}`;\n}\n\nconst requestedTime = to24Hour(req.preferred_time);\n\nconst rows = $input\n  .all()\n  .map(i => i.json)\n  .filter(r => r && r.Time);\n\nconst conflict = rows.some(r => {\n  return (\n    to24Hour(r.Time) === requestedTime &&\n    String(r.Status || \"\").toLowerCase() !== \"cancelled\"\n  );\n});\n\nif (!req.name || !req.phone || !req.preferred_date || !req.preferred_time) {\n  return [{\n    json: {\n      available: false,\n      missing: true,\n      response: \"I still need the caller's name, phone number, preferred date and preferred time.\"\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    available: !conflict,\n    missing: false,\n    response: conflict\n      ? `That slot on ${req.preferred_date} at ${req.preferred_time} is already booked. Please ask the caller to choose another time.`\n      : \"Slot is free.\"\n  }\n}];"
      },
