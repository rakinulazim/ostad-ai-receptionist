    {
      "parameters": {
        "jsCode": "const q = (($('Tool Input').first().json.query) || '').toLowerCase().trim();\nconst rows = $input.all().map(i => i.json).filter(r => r && (r.CourseName || r['Course Name']));\nif (!rows.length) {\n  return [{ json: { response: 'Sorry, the course catalog is currently empty. Offer to save the caller as a lead so the team can follow up.' } }];\n}\nconst nameOf = r => r.CourseName ?? r['Course Name'] ?? '';\nconst matches = q ? rows.filter(r => Object.values(r).join(' ').toLowerCase().includes(q)) : rows;\nif (!matches.length) {\n  return [{ json: { response: `No exact match found for \"${q}\". Available courses are: ` + rows.map(nameOf).join(', ') + '. Ask the caller which one interests them.' } }];\n}\nconst lines = matches.map(r => `${nameOf(r)} - Duration: ${r.Duration || ''}, Fee: ${r.Fee || ''} taka${r.BatchStart ? ', next batch ' + r.BatchStart : ''}${r.Schedule ? ', classes ' + r.Schedule : ''}`.trim());\nreturn [{ json: { response: lines.join(' | ') } }];"
      },
