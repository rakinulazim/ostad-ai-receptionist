    {
      "parameters": {
        "jsCode": "const q = (($('Tool Input').first().json.course_name) || '').toLowerCase().trim();\nconst rows = $input.all().map(i => i.json).filter(r => r && (r.CourseName || r['Course Name']));\nconst nameOf = r => r.CourseName ?? r['Course Name'] ?? '';\nif (!rows.length) {\n  return [{ json: { response: 'No upcoming class schedules are published yet. Offer to save the caller as a lead so the team can follow up.' } }];\n}\nconst matches = q ? rows.filter(r => String(nameOf(r)).toLowerCase().includes(q)) : rows;\nif (!matches.length) {\n  return [{ json: { response: `No upcoming batch found for \"${q}\". Courses with scheduled batches: ` + [...new Set(rows.map(nameOf))].join(', ') } }];\n}\nconst lines = matches.slice(0, 5).map(r => `${nameOf(r)}: next batch starts ${r.BatchStart ?? r['Start Date'] ?? 'soon'}, classes ${r.Schedule ?? r['Class Days'] ?? ''} ${r.Time ?? ''}`.trim());\nreturn [{ json: { response: lines.join(' | ') } }];"
      },
